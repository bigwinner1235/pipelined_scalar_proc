23 30 10 04  // sd x1, 64(x0)          -- retires before the trap: must commit
7f 00 00 00  // .word 0x0000007f       -- opcode 1111111 is reserved: halt = 1, illegal = 1
23 30 20 04  // sd x2, 64(x0)          -- past the halt: must not commit
23 34 20 04  // sd x2, 72(x0)          -- past the halt: must not commit
23 38 20 04  // sd x2, 80(x0)          -- past the halt: must not commit
