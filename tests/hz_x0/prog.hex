13 00 70 00  // addi x0, x0, 7         -- write to x0 is discarded
93 00 00 00  // addi x1, x0, 0         -- x0 must read 0: a naive forwarder would give 7
13 00 00 00  // nop
13 00 00 00  // nop
13 00 00 00  // nop
23 30 10 04  // sd x1, 64(x0)
6f 00 00 00  // jal x0, 0              -- halt (self-loop)
